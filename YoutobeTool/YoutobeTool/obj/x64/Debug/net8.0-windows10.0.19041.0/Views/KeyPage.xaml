<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YoutobeTool.Views.KeyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:YoutobeTool.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <InfoBar
            Title="Cài đặt"
            IsOpen="True"
            Severity="Informational">
            <InfoBar.Content>
                <Grid Padding="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="9*" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing
                        Width="30"
                        Height="30"
                        IsActive="{Binding IsActive}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,5,20,0"
                        FontSize="20"
                        Text="{Binding Status}"
                        TextAlignment="Center" />
                </Grid>
            </InfoBar.Content>
        </InfoBar>
        <TextBox
            Grid.Row="1"
            PlaceholderText="Nhập domain"
            Text="{Binding Domain, Mode=TwoWay}" />
        <TextBox
            Grid.Row="2"
            PlaceholderText="Nhập api"
            Text="{Binding ApiKey, Mode=TwoWay}" />
        <Grid Grid.Row="3" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <TextBox
                MinWidth="300"
                PlaceholderText="Nhập key bản quyền"
                Text="{Binding Key, Mode=TwoWay}" />
            <Button
                Grid.Column="1"
                Command="{Binding GetKeyClicked}"
                Content="Lấy mã"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                Grid.Column="2"
                Command="{Binding CheckKeyClicked}"
                Content="Kiểm tra key"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Button
                MinWidth="150"
                HorizontalAlignment="Left"
                Command="{Binding ResetModelClicked}"
                Content="Reset model"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                Grid.Column="1"
                MinWidth="150"
                Command="{Binding IsCheckChatGPTClicked}"
                Content="Kiểm tra API"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                Grid.Column="2"
                MinWidth="170"
                HorizontalAlignment="Right"
                Command="{Binding SaveDataClicked}"
                Content="Lưu data"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>

