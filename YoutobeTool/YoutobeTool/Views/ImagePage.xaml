<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YoutobeTool.Views.ImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:YoutobeTool.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Margin="20" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Hình ảnh" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Padding="10"
                    VerticalAlignment="Center"
                    Text="{Binding PathFolderText}" />
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Command="{Binding OnClickedChooseFolder}"
                    Content="Chọn folder chứa text"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>
                <NumberBox
                    HorizontalAlignment="Right"
                    PlaceholderText="Nhập số luồng"
                    Value="{Binding NumberTask, Mode=TwoWay}" />
                <Button
                    Grid.Column="1"
                    MinWidth="157"
                    HorizontalAlignment="Right"
                    Command="{Binding OnClickedCreateImages}"
                    Content="Tạo ảnh"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <controls:DataGrid
                Grid.Row="3"
                AutoGenerateColumns="False"
                ItemsSource="{Binding ImageModels}">
                <controls:DataGrid.Resources>
                    <Style TargetType="controls:DataGridCell">
                        <Setter Property="FontSize" Value="13" />
                    </Style>
                </controls:DataGrid.Resources>
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding Index}"
                        Header="STT" />
                    <controls:DataGridTextColumn
                        Width="*"
                        Binding="{Binding Name}"
                        Header="Tên file" />
                    <controls:DataGridTextColumn
                        Width="*"
                        Binding="{Binding Status}"
                        Header="Trạng thái" />
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Grid>
    </ScrollViewer>
</Page>
