<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YoutobeTool.Views.MusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:YoutobeTool.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <Grid Margin="20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Xử lý âm thanh" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="txtPathTexts"
                Padding="10"
                VerticalAlignment="Center"
                Text="{Binding PathTexts}" />
            <Button
                x:Name="btnFolderImages"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Command="{Binding ChooseFolderClicked}"
                Content="Chọn folder chứa text"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    DisplayMemberPath="VoiceName"
                    ItemsSource="{Binding Voices}"
                    PlaceholderText="Chọn giọng"
                    SelectedIndex="{Binding VoiceIndex, Mode=TwoWay}" />
                <ComboBox
                    Grid.Column="1"
                    DisplayMemberPath="VoiceType"
                    ItemsSource="{Binding VoiceItemModels}"
                    PlaceholderText="Chọn kiểu giọng"
                    SelectedIndex="{Binding VoiceItemIndex, Mode=TwoWay}" />
                <NumberBox
                    Grid.Column="2"
                    LargeChange="5"
                    PlaceholderText="Nhập tốc độ"
                    SmallChange="-1"
                    SpinButtonPlacementMode="Compact"
                    Value="{Binding Rate, Mode=TwoWay}" />
                <NumberBox
                    Grid.Column="3"
                    HorizontalContentAlignment="Right"
                    PlaceholderText="Nhập số luồng"
                    Value="{Binding NumberTask, Mode=TwoWay}" />
            </Grid>
            <Grid
                Grid.Column="1"
                HorizontalAlignment="Right"
                ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Command="{Binding RefreshClicked}"
                    Content="Refresh"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="btnTestVoice"
                    Grid.Column="1"
                    Command="{Binding TestVoiceClicked}"
                    Content="Nghe thử giọng"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="btnCreateVoice"
                    Grid.Column="2"
                    Command="{Binding CreateVoiceClicked}"
                    Content="Tạo voice"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
        <controls:DataGrid
            Grid.Row="3"
            AutoGenerateColumns="False"
            ItemsSource="{Binding MusicModels}">
            <controls:DataGrid.Resources>
                <Style TargetType="controls:DataGridCell">
                    <Setter Property="FontSize" Value="13" />
                </Style>
            </controls:DataGrid.Resources>
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Index}"
                    Header="STT" />
                <controls:DataGridTextColumn
                    Width="*"
                    Binding="{Binding NameFile}"
                    Header="Tên file" />
                <controls:DataGridTextColumn
                    Width="*"
                    Binding="{Binding Duration}"
                    Header="Độ dài" />
                <controls:DataGridTextColumn
                    Width="*"
                    Binding="{Binding Status}"
                    Header="Trạng thái" />
            </controls:DataGrid.Columns>
        </controls:DataGrid>
    </Grid>
</Page>
